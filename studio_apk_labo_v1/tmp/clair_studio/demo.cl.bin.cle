classes_v3.cl|208
Class Compteur {
    valeur: int

    def doubler() -> int {
        return self.valeur * 2
    }
}

def main() -> int {
    let compteur: Compteur = Compteur(21)
    print(compteur.doubler())
    return 0
}
classes_v4.cl|294
Class Moteur {
    puissance: int

    def doubler() -> int {
        return self.puissance * 2
    }
}

Class Machine {
    moteur: Moteur
}

def main() -> int {
    let moteur: Moteur = Moteur(21)
    let machine: Machine = Machine(moteur)

    print(machine.moteur.doubler())
    return 0
}
