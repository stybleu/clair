// V0.45 : fonctions mathematiques des grands nombres, comparees a mpmath et a Python
def main() -> int {
    print(pi(1000))
    print(sin(bigfloat("1e-30", 50)))
    print(cos(bigfloat("3.14159265358979323846264338327950288", 40)))
    print(log(bigfloat("1.0000000000000000000000000000001", 40)))
    let x: bigfloat = bigfloat("2", 50)
    print(sqrt(x))
    print(pi(60))
    print(sin(bigfloat(1, 40)))
    print(exp(bigfloat("1", 30)))
    print(log(bigfloat(10, 30)))
    print(atan2(bigfloat(1, 30), -3))
    print(pow(x, 0.5))
    print(pow(x, 100))
    print(x * 2 + 0.5)
    print(x / 3)
    print(1 - x)
    print(x > 1)
    print(float(sqrt(x)))
    print(int(pow(x, 60)))
    print(floor(bigfloat("-2.5", 10)))
    print(ceil(bigfloat("-2.5", 10)))
    print(bigint(bigfloat("123.9", 10)))
    let b: bigint = bigint("123456789012345678901234567890")
    print(isqrt(b))
    print(isqrt(17))
    print(gcd(b, bigint(30)))
    print(gcd(12, 18))
    print(pow(b, 3))
    print(pow(bigint(2), 1000, bigint(1000000007)))
    print(pow(3, 2, bigint(-5)))
    print(abs(bigint(-5)))
    print(abs(bigfloat(-2.5, 10)))
    print(bigfloat(b, 10))
    print(bigfloat(0.1, 30))
    print(float(b))
    print(int(b / 1000000000000))
    print(acos(bigfloat("-1", 20)))
    print(asin(bigfloat("1", 20)))
    print(tanh(bigfloat(1000, 20)))
    print(hypot(bigfloat(3, 20), 4))
    return 0
}
